# RunPod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_NANO=          # endpoint id for the nano worker (LTX-2.3)
RUNPOD_ENDPOINT_EIV=           # endpoint id for the eiv worker (LTX-2.3)
LORA_NANO=nano_artigiano_v1.safetensors   # LoRA filename on Network Volume loras/
LORA_EIV=eiv_v1.safetensors              # LoRA filename on Network Volume loras/
LORA_STRENGTH=0.9

# fal.ai — keyframe generation (Flux Dev + image LoRA)
FAL_KEY=
FAL_FLUX_MODEL=fal-ai/flux-lora
FAL_FLUX_LORA_URL=             # URL of the trained Flux image LoRA (.safetensors)
FAL_FLUX_LORA_SCALE=0.9

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nanobot-v-3
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRY=3600

# Polling
POLL_INTERVAL_SECONDS=5
POLL_TIMEOUT_SECONDS=900

# Gradio basic auth
GRADIO_AUTH_USER=
GRADIO_AUTH_PASS=
